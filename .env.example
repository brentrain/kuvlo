# Required for the application and authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://kuvlo.io
NEXT_PUBLIC_SITE_URL=https://kuvlo.io

# Required for invoice and reminder email delivery
RESEND_API_KEY=re_your-api-key
FROM_EMAIL=Kuvlo <noreply@kuvlo.io>

# Required for the scheduled job-reminder endpoint
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-value

# Optional recipient override for reminder notifications
NOTIFY_EMAIL=
